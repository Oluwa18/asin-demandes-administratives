APP_NAME="Suivi des demandes"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# PostgreSQL Supabase (Project Settings > Database > Connection parameters)
# Utiliser le "Session pooler" (port 5432) si le réseau ne supporte pas l'IPv6.
DB_CONNECTION=pgsql
DB_HOST=aws-0-eu-west-3.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.VOTRE_REF_PROJET
DB_PASSWORD=VOTRE_MOT_DE_PASSE
DB_SSLMODE=require

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Origine(s) du frontend autorisée(s) par CORS, séparées par des virgules
FRONTEND_URL=http://localhost:3000
